
from fastapi import FastAPI

app = FastAPI(
    title="VAHMITRA API",
    description="Smart Bus Tracking & Management System",
    version="1.0.0"
)


@app.get("/")
def home():
    return {
        "message": "Welcome to VAHMITRA API",
        "status": "running"
    }


@app.get("/health")
def health_check():
    return {
        "status": "healthy"
    }
